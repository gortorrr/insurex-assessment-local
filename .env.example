APP_ENV=local
DATABASE_BACKEND=local

ASSISTANT_DB_PATH=rag/db/assistant.sqlite
ANALYTICS_DB_PATH=data_modeling/db/analytics.sqlite
CHECKPOINT_DB_PATH=rag/db/checkpoints.sqlite

CHROMA_PATH=rag/chroma_db
KB_MANIFEST_PATH=rag/knowledge_base/manifest.json
EMBEDDING_MODEL=rag/models/multilingual-e5-small
EMBEDDING_DEVICE=cpu

LLM_PROVIDER=google_ai_studio
LLM_MODEL=gemini-3.5-flash-lite

# ใส่ API key
GOOGLE_API_KEY=

LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=1024
MAX_RETRIEVAL_RETRIES=1

RETRIEVAL_MODE=hybrid
TRACE_PATH=rag/traces
